{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "clipboard-manager:allow-read-text",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.deepseek.com/chat/completions" }]
    },
    "sql:default",
    "sql:allow-execute"
  ]
}